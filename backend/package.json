    "db:init:remote": "wrangler d1 execute kinntai-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.1",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
